function smite_chat(){
    self endon( "disconnect" );
    self endon("smite_chat_mod");

    // Disable smite chat
    if( isdefined( self.smite_chat_mod ) ){
        self.smite_chat_mod = undefined;
        self IPrintLnBold("^5Smite Chat ^1Disabled...");
        self notify("smite_chat_mod");
    // Enable smite chat
    }else{
        self.smite_chat_mod = true;
        self IPrintLnBold("^5Smite Chat ^2Enabled!");
        self thread watch_for_smite_chat_close();
    }

    // Wait for chat messages to be initialized
    while( !isdefined( level.smite_hud_initialized ) ) wait 0.05;

    if( !self has_key( BIND_V ) ){ // Checks if the player has the open quick chat button
        thread debug_message(self.name+" ^1doesn't have button 'V' to use ^5Smite Chat");
        return;
    }

    // Init smite chat menu
    self.smite_chat = [];
    self.smite_chat["open"] = false;
    self.smite_chat["cursor"] = level.smite_hud["Main"];

    // Init smite chat huds
    self.smite_hud = [];
    self.smite_hud["text_shadows"] = [];

    // Needed to print player's color on Smite Chat
    while( !isdefined(self.entity_num) ) wait 0.05;

    for(;;){

        while( !self is_key_pressed( BIND_V )) wait 0.1;// wait 0.05; // Waits for the player to press the Key
        while( self is_key_pressed( BIND_V )) wait 0.1;// wait 0.05; // Waits for the player to unpress the Key

        // Avoid using Smite Chat while using another mod that requires keyboard focus
        if( self has_special_menu_open() ){
            #ifdef dev
                self iPrintLnBold("Can't open smite chat rn");
            #endif
            continue;
        }

        self.smite_chat["cursor"] = level.smite_hud["Main"]; // Initializes chat options
        self.smite_chat["open"] = true; // Set the menu as opened

        // Update smite chat messages options
        options_names = self update_smite_chat_options();

        // Erroring when no valid keys found
        if( !options_names.size ) self close_smite_chat( true );
        // Executing smite menu
        else self thread refresh_smite_huds( options_names ); // Create smite huds and at the end handle the key logic and set the cursor to chosen option

        // Keep looping until we close the menu
        for(;;){

            self waittill( "smite_response" ); // Waits for an option to be chosen

            // We chose to close the menu
            if( !self.smite_chat["open"] ) break;

            // Not an array of options means it's a message to print
            if( !IsArray(self.smite_chat["cursor"]) ){
                level thread DisplayFeedMessage( self smite_message_parser( self.smite_chat["cursor"] ) ); // Print the message
                self close_smite_chat();
                break;
            }

            // Update smite chat messages options
            options_names = self update_smite_chat_options();

            // Player doesn't have any of the keys required for this menu
            if( !options_names.size ) self close_smite_chat( true );
            // Executing smite menu
            else self thread refresh_smite_huds( options_names ); // Create smite huds and at the end handle the key logic and set the cursor to chosen option

        }

    }

}

// Get the texts from the next chosen Smite Chat option
function update_smite_chat_options(){

    options_names = getArrayKeys( self.smite_chat["cursor"] );
    for(i=options_names.size-1; i>=0; i--) if( !self has_key( options_names[i][0] ) ) ArrayRemoveIndex(options_names, i, 0);
    return options_names;
}

// Closes Smite Chat
function close_smite_chat( b_error = false ){

    if( b_error ) self debug_message_instant("No valid keys for smite chat", self); // Print the reason for closing to the player
    self.smite_chat["cursor"] = level.smite_hud["Main"]; // Set cursor back to main chat
    self delete_smite_huds(); // Remove all huds
    self.smite_chat["open"] = false; // Set menu as closed   
}

// Closes Smite Chat when it's toggled off
function watch_for_smite_chat_close(){
    self endon( "disconnect" );

    // This notify means that we want to untoggle smite chat mod
    self waittill("smite_chat_mod");

    // Smite Chat huds are active
    if( self.smite_chat["open"] ) self delete_smite_huds();

    self.smite_chat = undefined;
    self.smite_hud = undefined;
    self.b_vkey_closes = undefined;
}

// Notify that an option has been chosen
function smite_chat_notify( options_names ){
    self endon( "disconnect" );
    self endon("smite_chat_mod");
    self endon("smite_response");

    // Let's assume there is no V key option, therefore it should close the Smite Chat
    self.b_vkey_closes = true;
    foreach( option in options_names ){
        // We found an option for V key, don't close chat when pressing it
        if( option[0] == BIND_V ) {
            self.b_vkey_closes = false;
            break;
        }
    }

    // Add the closing smite chat keys that the player has
    foreach( bind in SMITE_CLOSE_CHAT_BINDS ) if( self has_key( bind ) ) ArrayInsert(options_names, bind, options_names.size);

    for(;;){
        wait 0.05;

        // Check all possible options
        foreach(option in options_names){

            // Close chat key detected, the key name may have more than 1 letter, use the full name
            if( IsInArray(SMITE_CLOSE_CHAT_BINDS, option ) && self is_key_pressed( option ) )
            {
                // Wait for key to unpress
                while( self is_key_pressed( option ) ) wait 0.05;

                //self IPrintLnBold("Closing smite? "+option);

                self close_smite_chat(); // Close smite chat
                self notify("smite_response"); // Notify that an option has been chosen

            // Check if Option key is being pressed
            }else if( !IsInArray(SMITE_CLOSE_CHAT_BINDS, option ) && self is_key_pressed( option[0] ) ){
                // Wait for key to unpress
                while( self is_key_pressed( option[0] ) ) wait 0.05;

                self.smite_chat["cursor"] = self.smite_chat["cursor"][ option ]; // Set cursor to chosen chat
                self notify("smite_response"); // Notify that an option has been chosen
            
            // If V key closes the chat, check that key specifically
            }if( self.b_vkey_closes && self is_key_pressed( BIND_V ) ){
                // Wait for key to unpress
                while( self is_key_pressed( BIND_V ) ) wait 0.05;

                //self IPrintLnBold("Closing smite? "+BIND_V);

                self close_smite_chat(); // Close smite chat
                self notify("smite_response"); // Notify that an option has been chosen

            }
            

        }
    }

}



function smite_get_void_background_height( n_options ){

    return (-95 + (20 * n_options) ) + ( 20 * ( ( 15 - n_options ) / 2 ) );
}

function smite_should_redraw_void_background( n_options ){

    // All option slots are going to be drawn, therefore there will not be any background
    if( n_options == 15){
        // Delete void background
        if( isdefined( self.smite_hud["void_background"] ) ) self.smite_hud["void_background"] hud::destroyelem();
        return false;
    }

    // We need to draw it at least for the first time whenever it's needed
    if( !isdefined( self.smite_hud["void_background"] ) ) return true;

    // Get current info
    new_height = smite_get_void_background_height( n_options );
    current_height = self.smite_hud["void_background"].y;

    // Check if it's already the desired height
    return current_height != new_height;
}

function smite_get_text_background_height( n_options ){

    return ( -88 + (20 * n_options ) - (10 * n_options ) );
}

function smite_should_redraw_text_background( n_options ){

    // We need to draw it at least for the first time whenever it's needed
    if( !isdefined( self.smite_hud["text_background"] ) ) return true;

    // Get info
    new_height = smite_get_text_background_height( n_options );
    current_height = self.smite_hud["text_background"].y;

    // Check if it's already the desired height
    return current_height != new_height;
}

function refresh_smite_huds( options ){

    // Draw top border and shadow
    if( !isdefined( self.smite_hud["top_border"] ) ) self.smite_hud["top_border"]	= self createRectangle(SMITE_HUD_TOP_X, SMITE_HUD_TOP_BORDER_Y, SMITE_ALIGNMENT, SMITE_COLOR_BORDERS, SMITE_SORT_3, 1, "white", 130, 10);
	if( !isdefined( self.smite_hud["top_shadow"] ) ) self.smite_hud["top_shadow"]	= self createRectangle(SMITE_HUD_TOP_X, SMITE_HUD_TOP_SHADOW_Y, SMITE_ALIGNMENT, SMITE_COLOR_SHADOW, SMITE_SORT_4, 0.5, "white", 130, 3 );

    // Redraw void background which is a transparent background
    if( self smite_should_redraw_void_background( options.size ) ){
        // Remove old one
        if( isdefined( self.smite_hud["void_background"] ) ) self.smite_hud["void_background"] hud::destroyelem();
        // Draw new one
        self.smite_hud["void_background"] = self createRectangle(50, smite_get_void_background_height( options.size ), SMITE_ALIGNMENT, SMITE_COLOR_VOID, SMITE_SORT_1, 0.8, "white", 130, ( 300 - (20 * options.size)));
    }

    // Make one big text to save configstringindexes
    super_text = "";
	for(i=options.size-1; i>=0; i--) super_text += (options[i] + "\n");

    // Draw smite chat options
    if( !isdefined( self.smite_hud["smite_text"] ) ) self.smite_hud["smite_text"]	= self createText(60, -75, SMITE_ALIGNMENT, SMITE_COLOR_TEXT, SMITE_SORT_3, 1, super_text, "objective", 1.6);
    else self.smite_hud["smite_text"] setText( super_text );

    // Each text option has an opaque background
    if( self smite_should_redraw_text_background( options.size ) ){
        // Remove old one
        if( isdefined( self.smite_hud["text_background"] ) ) self.smite_hud["text_background"] hud::destroyelem();

        // Draw new one
        self.smite_hud["text_background"] = self createRectangle(50, smite_get_text_background_height( options.size ), SMITE_ALIGNMENT, SMITE_COLOR_BACKGROUND, SMITE_SORT_2, 1,"white", 130, ( (20 * options.size) -5) );
    }

    // We need to delete some shadows
    if( self.smite_hud["text_shadows"].size+1 >  options.size ){
        //level thread debug_message_instant("Remove some smite shadows "+(self.smite_hud["text_shadows"].size+1 - options.size) );

        for(i=self.smite_hud["text_shadows"].size-1; i>options.size-1; i--){

            // Message is already destroyed, THIS SHOULDN'T HAPPEN
            if( !isdefined( self.smite_hud["text_shadows"][i] ) ){
                level thread debug_message_instant( "REFRESH | HUD shadow already destroyed! Pos "+i );
                continue;
            }

            hud_shadow = self.smite_hud["text_shadows"][i];
            ArrayRemoveValue(self.smite_hud["text_shadows"], hud_shadow, 0);
            hud_shadow hud::destroyelem();
        }

    }
    // Instead of deleting, we needed to create more shadows
    else if( self.smite_hud["text_shadows"].size+1 <  options.size ){
        //level thread debug_message_instant("Adding some smite shadows "+(self.smite_hud["text_shadows"].size+1 - options.size) );

        for(i=self.smite_hud["text_shadows"].size; i<options.size-1; i++) ArrayInsert(self.smite_hud["text_shadows"], self createRectangle(50, (-64 + (19 * i)), SMITE_ALIGNMENT, SMITE_COLOR_SHADOW, 4, 0.5, "white", 130, 3 ), self.smite_hud["text_shadows"].size);
    }


    // Draw bottom border and shadow
	if( !isdefined( self.smite_hud["bottom_border"] ) ) self.smite_hud["bottom_border"]	= self createRectangle(50, 210, SMITE_ALIGNMENT, SMITE_COLOR_BORDERS, SMITE_SORT_3, 1, "white", 130, 10 );
	if( !isdefined( self.smite_hud["bottom_shadow"] ) ) self.smite_hud["bottom_shadow"]	= self createRectangle(50, 205, SMITE_ALIGNMENT, SMITE_COLOR_SHADOW, SMITE_SORT_4, 0.5, "white", 130, 3 );

    // Draw side shadows
	if( !isdefined( self.smite_hud["left_shadow"] ) ) self.smite_hud["left_shadow"]	    = self createRectangle(50,  65, SMITE_ALIGNMENT, SMITE_COLOR_SHADOW, SMITE_SORT_3, 1, "white", 5, 300 );
	if( !isdefined( self.smite_hud["right_shadow"] ) ) self.smite_hud["right_shadow"]	= self createRectangle(175, 65, SMITE_ALIGNMENT, SMITE_COLOR_SHADOW, SMITE_SORT_3, 1, "white", 5, 300 );
	// Dist is 125

    // Handle key logic and set the cursor to chosen option
    self thread smite_chat_notify( options );
}


function delete_smite_huds(){

    self.smite_hud["top_border"]            hud::destroyelem();
    self.smite_hud["top_shadow"]            hud::destroyelem();

    if( isdefined( self.smite_hud["void_background"] ) ) self.smite_hud["void_background"]       hud::destroyelem();
    self.smite_hud["smite_text"]            hud::destroyelem();
    self.smite_hud["text_background"]       hud::destroyelem();

    for(i=self.smite_hud["text_shadows"].size-1; i>=0; i--){

        // Message is already destroyed, THIS SHOULDN'T HAPPEN
        if( !isdefined( self.smite_hud["text_shadows"][i] ) ){
            level thread debug_message_instant( "DELETE | HUD shadow already destroyed! Pos "+i );
            continue;
        }

        hud_shadow = self.smite_hud["text_shadows"][i];
        ArrayRemoveValue(self.smite_hud["text_shadows"], hud_shadow, 0);
        hud_shadow hud::destroyelem();
    }

    self.smite_hud["bottom_border"]         hud::destroyelem();
    self.smite_hud["bottom_shadow"]         hud::destroyelem();

    self.smite_hud["left_shadow"]           hud::destroyelem();
    self.smite_hud["right_shadow"]          hud::destroyelem();

}

function smite_message_parser( message = "[Unknown] Error getting the message" ){

    // Init new text
	str_smite_message = "";

    // Parse the chat message
	for(i=0; i<message.size; i++){

        // Color inside the brackets
		if( message[i] == "[" ) str_smite_message += "^8"+message[i]+"^6";
        // Color outside the brackets
		else if( message[i] == "]" ) str_smite_message += "^8"+message[i]+"^8";
        // Just add the text
		else str_smite_message += message[i];

	}

    return sprintf( "{0}{1} {2}", self get_player_text_color(), self.name, str_smite_message );
}